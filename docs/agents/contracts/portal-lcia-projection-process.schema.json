{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/contracts/portal-lcia-projection-process.schema.json",
  "title": "Portal LCIA projection Process axis record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "processIndex",
    "processId",
    "processVersion",
    "referenceFlowId",
    "referenceFlowVersion",
    "referenceExchangeInternalId",
    "referenceFlowAmount",
    "referenceFlowDirection",
    "functionalUnitAmount",
    "functionalUnitUnit",
    "functionalUnitDescription",
    "geographyCode",
    "geographyPrecision",
    "referenceYear",
    "processDocumentSha256"
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^-?(?=(?:[^0-9]*[0-9]){1,38}[^0-9]*$)(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
    },
    "localizedText": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "value"],
        "properties": {
          "language": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
          },
          "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  },
  "properties": {
    "processIndex": { "type": "integer", "minimum": 0 },
    "processId": { "type": "string", "format": "uuid" },
    "processVersion": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$" },
    "referenceFlowId": { "type": "string", "format": "uuid" },
    "referenceFlowVersion": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$" },
    "referenceExchangeInternalId": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,5})$" },
    "referenceFlowAmount": { "$ref": "#/$defs/decimal" },
    "referenceFlowDirection": { "enum": ["input", "output"] },
    "functionalUnitAmount": { "$ref": "#/$defs/decimal" },
    "functionalUnitUnit": { "type": "string", "minLength": 1, "maxLength": 128 },
    "functionalUnitDescription": { "$ref": "#/$defs/localizedText" },
    "geographyCode": { "type": "string", "minLength": 1, "maxLength": 128 },
    "geographyPrecision": { "enum": ["country", "province", "city", "other", "unknown"] },
    "referenceYear": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "processDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
